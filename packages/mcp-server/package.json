{
  "name": "voice-mcp",
  "version": "1.0.0",
  "description": "MCP server providing text-to-speech voice tools for Claude Code agents",
  "type": "module",
  "bin": {
    "voice-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node18 --dts --clean",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "Gabe Nodland",
  "repository": {
    "type": "git",
    "url": "https://github.com/gabenodland/voice-mcp"
  },
  "keywords": ["mcp", "voice", "tts", "text-to-speech", "claude", "edge-tts"]
}
