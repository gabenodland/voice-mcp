{
  "name": "@voice-mcp/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main/index.js",
  "bin": {
    "voice-mcp-backend": "./dist/main/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');const p=require('path');const src=p.join('src','renderer');const dst=p.join('dist','renderer');fs.mkdirSync(dst,{recursive:true});fs.readdirSync(src).forEach(f=>fs.copyFileSync(p.join(src,f),p.join(dst,f)))\"",
    "dev": "tsx src/main/index.ts"
  },
  "dependencies": {
    "@voice-mcp/shared": "*",
    "express": "^5.1.0",
    "koffi": "^2.9.0",
    "node-edge-tts": "^1.2.10",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0"
  },
  "optionalDependencies": {
    "audify": "^1.10.1",
    "mpg123-decoder": "^1.0.3"
  }
}
